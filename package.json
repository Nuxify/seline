{
	"name": "seline",
	"version": "2.1.0",
	"private": true,
	"engines": {
		"node": ">=22",
		"npm": ">=11.6.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write . && eslint --fix .",
		"test:e2e": "playwright test",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:headed:chrome": "playwright test --headed --project=chromium",
		"test:unit": "vitest tests/unit",
		"test:component": "vitest tests/component"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.13",
		"@types/eslint": "^8.56.12",
		"@typescript-eslint/eslint-plugin": "^8.73.0",
		"@typescript-eslint/parser": "^8.73.0",
		"autoprefixer": "^10.6.2",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^9.1.2",
		"eslint-plugin-svelte": "^2.46.1",
		"flowbite": "^4.0.2",
		"flowbite-svelte": "^1.33.1",
		"jsdom": "^29.1.1",
		"postcss": "^8.5.33",
		"postcss-load-config": "^5.1.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"sass": "^1.108.2",
		"svelte": "^5.58.0",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"tslib": "^2.9.1",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^4.1.12"
	},
	"type": "module",
	"dependencies": {
		"axios": "^1.21.1",
		"playwright": "^1.65.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
