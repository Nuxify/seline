{
	"name": "seline",
	"version": "2.0.2",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write . && eslint --fix .",
		"test:e2e": "playwright test",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:headed:chrome": "playwright test --headed --project=chromium",
		"test:unit": "vitest tests/unit",
		"test:component": "vitest tests/component"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^4.0.4",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.7",
		"@types/eslint": "^8.56.12",
		"@typescript-eslint/eslint-plugin": "^8.71.1",
		"@typescript-eslint/parser": "^8.71.1",
		"autoprefixer": "^10.6.1",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^9.1.2",
		"eslint-plugin-svelte": "^2.46.1",
		"flowbite": "^2.5.2",
		"flowbite-svelte": "^0.47.4",
		"jsdom": "^29.1.1",
		"postcss": "^8.5.29",
		"postcss-load-config": "^5.1.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"sass": "^1.105.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^3.4.19",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"vite": "^5.4.21",
		"vitest": "^1.6.1"
	},
	"type": "module",
	"dependencies": {
		"axios": "^1.20.0",
		"playwright": "^1.64.0"
	},
	"optionalDependencies": {
		"@rollup/rollup-linux-x64-gnu": "^4.64.2"
	}
}
